# One env file for the whole repo. Copy to `.env` and fill in the keys.
# Loaded by apps/api, apps/web (next.config.ts) and packages/db (drizzle.config.ts).

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://visualize:visualize@localhost:5432/visualize

# --- API server ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- AI & search ---
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=gemini-2.5-flash
TAVILY_API_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
